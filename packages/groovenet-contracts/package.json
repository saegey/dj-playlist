{
  "name": "@groovenet/contracts",
  "version": "0.1.0",
  "description": "Shared runtime schemas and inferred types for the Groovenet API",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage --coverage.include=src/liveSets.ts --coverage.include=src/playlists.ts --coverage.reporter=lcov"
  },
  "files": ["build/"],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.3",
    "typescript": "^7.0",
    "vitest": "^5.0.0"
  },
  "license": "MIT"
}
