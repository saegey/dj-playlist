{
  "type": "module",
  "name": "my-collection-search",
  "version": "0.1.2",
  "private": true,
  "trustedDependencies": [
    "@sentry/cli",
    "core-js",
    "esbuild",
    "fsevents",
    "sharp",
    "unrs-resolver"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "test:db": "RUN_DB_TESTS=1 vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "migrate": "node-pg-migrate",
    "psql": "docker compose exec db psql -U djplaylist -d djplaylist",
    "worker": "tsx src/workers/index.ts",
    "worker:dev": "nodemon --watch src --ext ts,js --exec 'npm run worker'",
    "backfill-identity": "tsx src/scripts/backfill-identity.ts",
    "screenshots:mobile": "tsx scripts/mobile-screenshots.ts",
    "backfill-audio-vibe": "tsx src/scripts/backfill-identity.ts -- --type=audio_vibe",
    "backfill-essentia": "tsx src/scripts/backfill-essentia.ts",
    "openapi:check": "node --import tsx/esm scripts/check-openapi.ts",
    "openapi:generate-spec": "node --import tsx/esm scripts/generate-openapi-json.ts ../openapi-generated.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.36.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hello-pangea/dnd": "^18.0.1",
    "@sentry/nextjs": "^10.59.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "cmdk": "^1.1.1",
    "essentia.js": "^0.1.3",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "next": "^16.3.4",
    "next-themes": "^0.4.6",
    "openai": "^5.23.2",
    "pg": "^8.22.0",
    "posthog-js": "^1.391.2",
    "posthog-node": "^5.38.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "uuid": "^13.0.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@playwright/test": "1.61.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/ioredis": "^4.28.10",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "jsdom": "29.1.1",
    "node-pg-migrate": "^8.0.4",
    "nodemon": "^3.1.14",
    "tsx": "^4.22.4",
    "typescript": "5.9.3",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0",
    "storybook": "^10.4.6",
    "@storybook/nextjs-vite": "^10.4.6",
    "vite": "^8.1.3",
    "eslint-plugin-storybook": "^10.4.6"
  }
}
